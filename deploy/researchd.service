# A systemd *user* unit for the Research OS control plane.
#
# This file is shipped, not installed. Nothing in this repository copies it,
# enables it, or reloads systemd: AGENTS.md rule 13 reserves enabling a
# persistent service to the researcher, and a tool that quietly installs a
# background service on your machine has made a decision that was yours.
#
# To use it, deliberately:
#
#   mkdir -p ~/.config/systemd/user ~/.config/research-os
#   cp deploy/researchd.service ~/.config/systemd/user/
#   # Put the DSN somewhere only you can read. `touch` and `chmod`, not
#   # `install -m 600 /dev/null`, which silently truncates the file -- so
#   # re-running this after adding a provider credential would delete it.
#   touch ~/.config/research-os/researchd.env
#   chmod 600 ~/.config/research-os/researchd.env
#   # Then *edit* that file and add the line, rather than echoing a password
#   # onto a command line where your shell history keeps it:
#   #   RESEARCH_OS_RUNTIME_DSN=<your dsn>
#   systemctl --user daemon-reload
#   systemctl --user enable --now researchd
#   journalctl --user -u researchd -f
#
# A *user* unit rather than a system one, because everything the runtime touches
# belongs to one person: their repositories, their XDG directories, their
# provider credentials. A system service would run as root over a researcher's
# home directory, which is a worse answer to every question.
#
# `loginctl enable-linger <user>` if you want it to keep running while you are
# logged out, and if you want it to come back after a reboot without you
# logging in first. That is also your decision, and without it a reboot leaves
# the control plane stopped until your next login.
#
# If the runtime's database is the disposable local one, install
# `researchd-db.service` too -- otherwise a reboot leaves this unit retrying
# against a cluster nobody started.

[Unit]
Description=Research OS autonomous-runtime control plane
Documentation=file://%h/research/research-os-rc/docs/RUNTIME.md
# The daemon degrades gracefully when the database is absent -- it retries --
# so this is a preference, not a hard requirement.
After=network-online.target
# Ordering only, and `Wants` rather than `Requires`: a runtime pointed at a
# real PostgreSQL has no researchd-db unit installed, and a missing wanted unit
# must not stop the control plane from starting.
Wants=researchd-db.service
After=researchd-db.service

# A crash loop must end somewhere a person can see. Without a start limit,
# `Restart=on-failure` retries a permanently broken configuration every ten
# seconds forever, and `systemctl --user status` reports "activating" rather
# than the truth. Six failures inside ten minutes is a real fault: the unit
# enters `failed`, stays there, and `systemctl --user reset-failed researchd`
# is the deliberate way back.
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=simple

# The DSN may contain a password, so it is read from a file the researcher owns
# rather than written here. A unit file is world-readable; this is not.
#
# The same file is where provider credentials belong, and there is a reason to
# put them there that was learned the hard way.
#
# PROVIDER CREDENTIAL ISOLATION, and why you may want it.
#
# This daemon runs the provider CLI as a subprocess with this user's
# environment, so by default it reads the same configuration directory and the
# same OAuth token as every interactive session on the machine. On 2026-09-19
# an interactive session and this daemon refreshed that token at the same
# moment; the refresh failed for both, and the runtime spent five minutes
# unable to reach any provider:
#
#   Failed to refresh OAuth token: another Claude Code process is refreshing
#   it or exited mid-refresh.
#
# The runtime now survives that -- work waits for the breaker's cooldown and
# resumes, and docs/RUNTIME.md §17 is the contract -- so this is an
# optimisation, not a prerequisite. It stops the collision instead of
# recovering from it.
#
# Three ways, all of which require YOU to authenticate. Nothing in this
# repository installs a credential, copies one, or reads one, and none of them
# may be committed:
#
#   1. a separate configuration directory with its own login. Verified on this
#      machine: the CLI honours CLAUDE_CONFIG_DIR and an empty directory
#      reports `loggedIn: false`, so the daemon gets a credential store of its
#      own rather than sharing yours.
#
#        mkdir -p ~/.config/research-os/provider-home
#        CLAUDE_CONFIG_DIR=~/.config/research-os/provider-home claude auth login
#        printf 'CLAUDE_CONFIG_DIR=%s\n' "$HOME/.config/research-os/provider-home" \
#          >> ~/.config/research-os/researchd.env
#
#      (One `%s`, not two. `%%` is printf's escape for a literal percent, so
#      the doubled form writes `CLAUDE_CONFIG_DIR=%s` and throws the path
#      away -- a relative path the CLI then resolves against its working
#      directory, which is an artifact root or a project worktree. The
#      isolation silently does not happen and a directory named `%s` appears
#      in a checkout. An independent security review found this in the first
#      version of these instructions.)
#
#      PUT IT OUTSIDE ~/.config/research-os, which this example does not.
#      `tests/conftest.py` walks the four real Research OS directories before
#      and after every test session and reports anything that appeared, so
#      that a test which escapes its temporary root is caught. The provider
#      CLI writes session files, key files and `.claude.json` backups into its
#      config directory constantly -- so a provider home *inside* one of those
#      four roots makes that guard fire on every suite run that overlaps with
#      a live `researchd`, with entries like
#
#        .config/research-os/<home>/sessions/972.json
#        .config/research-os/<home>/backups/.claude.json.backup.<stamp>
#
#      Found by running the suite alongside the daemon during the 2026-09-21
#      dogfood. Nothing was actually contaminated and the guard was right to
#      say so: provider session churn is not Research OS state and does not
#      belong under the Research OS config home. Somewhere like
#      `~/.local/state/provider-homes/research-os` keeps both true.
#
#   2. a long-lived token from `claude setup-token`, written into the
#      EnvironmentFile under the variable that command tells you to use;
#
#   3. an API key in ANTHROPIC_API_KEY, which the CLI documents. Different
#      billing, so it is a decision rather than a default.
#
# Whichever you choose: `chmod 600` the file, and never copy it into a
# checkout -- not even into `deploy/` beside this unit, which is the obvious
# mistake and the one `.gitignore` is now widened to catch. The file lives
# under ~/.config and stays there. SECURITY.md is the full boundary.
EnvironmentFile=%h/.config/research-os/researchd.env

# uv run, so the daemon uses the project environment the tests ran against
# rather than whatever happens to be on PATH. `--frozen` so a service start can
# never silently resolve a different dependency set than the one that was
# tested.
#
# Change WorkingDirectory to whichever checkout you actually run. It is a real
# choice, not boilerplate: this machine has ten worktrees of this repository,
# and the daemon runs the code in the one named here.
WorkingDirectory=%h/research/research-os-rc
ExecStart=/usr/bin/env uv run --frozen --extra runtime researchd --log-level INFO

# SIGTERM asks the loop to finish its current pass. A pass is short, and the
# work it was running keeps its lease, which expires and is recovered -- so a
# hard kill loses nothing either. 90s is generous.
KillSignal=SIGTERM
TimeoutStopSec=90

Restart=on-failure
RestartSec=10s

# Starting twice is safe. The daemon takes a PostgreSQL advisory lock for the
# database it is attached to, and a second control plane finds the lock held,
# says so, and exits zero without starting a loop. So `systemctl --user start
# researchd` beside a daemon already running in a terminal is a no-op rather
# than two loops competing for the same work rows.

# Hardening -- and read the next paragraph before believing any of it.
#
# MEASURED, NOT ASSUMED: on this reference host the mount-namespace directives
# below (`ProtectSystem=`, `PrivateTmp=`, `ReadWritePaths=`) are accepted, the
# unit starts, and **they do not bind**. A user manager cannot build the
# namespace they need while `kernel.apparmor_restrict_unprivileged_userns=1`,
# and systemd does not fail the unit when it cannot. Checked rather than
# reasoned about:
#
#   systemd-run --user -p PrivateTmp=true /bin/sh -c 'touch /tmp/probe'
#   # /tmp/probe is visible on the host afterwards -> PrivateTmp did not bind
#
#   systemd-run --user -p ProtectSystem=strict /bin/sh -c 'touch $HOME/probe'
#   # succeeds -> the hierarchy is not read-only
#
# This is the same silent ineffectiveness SECURITY.md records for
# `systemd-run --user` as a containment backend, and `sandbox.py` refuses that
# backend for exactly this reason. The directives are kept because they are
# correct and do bind on a *system* unit, and because a host without that
# AppArmor restriction gets them -- but on this machine they are a statement
# of intent, not a boundary.
#
# Two that DO apply here, because they need no namespace: `NoNewPrivileges=`
# and the `Restrict*`/`Remove*` set below, which are prctl and seccomp
# operations.
#
# Note also what is not locked down even where these do bind: the daemon runs
# project acceptance commands, which means running project code, so this is
# defence in depth and not a sandbox. docs/RUNTIME.md and SECURITY.md state
# that boundary in full.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# ProtectHome is deliberately NOT `read-only` here, and that was a bug rather
# than a hardening decision. The control plane creates Git worktrees for
# automation runs, and `git worktree add` writes into the *source* repository's
# `.git/worktrees/`, which lives under the researcher's project directory. With
# `ProtectHome=read-only` every write task fails on a read-only filesystem, and
# a control plane that cannot run a write task is not a control plane.
#
# So home stays writable and the paths below are documentation rather than a
# boundary. If you want a real boundary, list your project repositories in
# ReadWritePaths and set ProtectHome=tmpfs with BindPaths for each -- and read
# the next paragraph first, because it limits what that would buy you.
ProtectHome=false
ReadWritePaths=%h/.local/state/research-os %h/.local/share/research-os %h/.cache/research-os
ProtectKernelTunables=true
ProtectControlGroups=true

# `ProtectKernelModules=true` is deliberately absent, and its absence was found
# by installing this file rather than by reading it.
#
# It is the one directive here a *user* manager cannot apply. It asks systemd to
# drop `CAP_SYS_MODULE` from the capability bounding set, an unprivileged
# manager may not touch the bounding set, and the unit therefore does not
# degrade -- it fails to start, with `status=218/CAPABILITIES` and
# `Failed to drop capabilities: Operation not permitted`, then crash-loops into
# `StartLimitBurst`. Every other directive below and above it applies cleanly.
#
# Removing it costs nothing measurable, which was checked rather than assumed. A
# process started by this user manager reports `CapPrm`, `CapEff` and `CapInh`
# all zero -- it holds no capabilities at all -- and `NoNewPrivileges=true`,
# which does apply, forbids it gaining any through a setuid binary. So the
# bounding set is the ceiling on privileges this service has no route to reach,
# and lowering that ceiling by one bit changed nothing except whether systemd
# would start the process.
#
# On a *system* unit the directive works and is worth having. This file is a
# user unit by design -- see the header -- so it is not.
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=default.target
